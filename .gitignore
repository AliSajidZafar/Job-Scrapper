# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local secret / credential files — NEVER commit (keep on disk only)
# passwords
Mavericks-admin-login.txt
password.txt
Mavericks Job Scrapper Supabase password.txt
*password*.txt
*passwords*.txt
*.password.txt
*supabase*password*.txt
*admin-login*.txt
# generic secrets / credentials
*secret*.txt
*secrets*.txt
*.secret
*credential*.txt
*credentials*.json
*.credentials
# keys & certificates (*.pem already ignored above)
*.key
*.pfx
*.p12
*.cer
*.crt
*.asc
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
# auth / session state
*storage-state*.json
*storageState*.json

